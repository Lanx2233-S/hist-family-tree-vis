    { "personId": "d2dd406e-702b-425c-b3dc-2dcac8e8163d", "startYear": 1108, "endYear": 1137, "titleForm": "King of the Franks", "note": "Succeeded his father Philippe I.", "noteCn": "继承父亲腓力一世。" },
    { "personId": "6ae9afe1-d639-482e-b9ea-13d27778f842", "startYear": 1137, "endYear": 1180, "titleForm": "King of the Franks", "note": "Succeeded his father Louis VI.", "noteCn": "继承父亲路易六世。" },
    { "personId": "7cc009b6-08d8-459b-b40e-2921bf3e4580", "startYear": 1180, "endYear": 1223, "titleForm": "King of France", "note": "Succeeded his father Louis VII; first to style himself King of France.", "noteCn": "继承父亲路易七世，并首创“法兰西国王”称号。" },
