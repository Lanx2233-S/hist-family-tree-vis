  "holders": [
    { "personId": "da77a416-665f-4fe8-bf64-bc42e258e27f", "startYear": 843, "endYear": 877, "titleForm": "King of West Francia", "note": "First king of West Francia after the Treaty of Verdun.", "noteCn": "《凡尔登条约》后首任西法兰克国王。" },
    { "personId": "160d3b66-92e1-482d-8611-dc03009fd5d2", "startYear": 877, "endYear": 879, "titleForm": "King of West Francia", "note": "Succeeded his father Charles the Bald.", "noteCn": "继承父亲秃头查理。" },
    { "personId": "b65eb6b7-9618-4e9f-9510-e5bb7c17e723", "startYear": 879, "endYear": 882, "titleForm": "King of West Francia", "note": "Joint king with his brother Carloman II.", "noteCn": "与兄卡洛曼二世共治。" },
    { "personId": "f284e83c-0009-4557-b225-fc428a357d12", "startYear": 879, "endYear": 884, "titleForm": "King of West Francia", "note": "Joint king with Louis III, then sole king.", "noteCn": "与路易三世共治，后为唯一国王。" },
    { "personId": "fc980fe9-6d96-4750-9b7f-cbc58b65bfd8", "startYear": 885, "endYear": 887, "titleForm": "King of West Francia", "note": "After Carloman II's death, West Frankish nobles chose the emperor Charles the Fat while the heir Charles was still a child and Viking attacks continued.", "noteCn": "卡洛曼二世去世后，因继承人查理尚年幼且诺曼人入侵，西法兰克贵族拥立当时的皇帝胖子查理。" },
    { "personId": "6bec1a5d-e19f-43eb-a2c6-b8f6d223a9a5", "startYear": 888, "endYear": 898, "titleForm": "King of West Francia", "note": "First non-Carolingian king, elected after Charles the Fat's deposition.", "noteCn": "胖子查理被废后当选的首位非加洛林国王。" },
    { "personId": "d7809609-2a6a-47bf-819f-2af8d7c31365", "startYear": 898, "endYear": 922, "titleForm": "King of West Francia", "note": "Restored the Carolingians after Odo's death.", "noteCn": "厄德去世后恢复加洛林王系。" },
    { "personId": "1894e7be-c18e-4182-9bca-927c9cbfa333", "startYear": 922, "endYear": 923, "titleForm": "King of West Francia", "note": "Elected in opposition to Charles the Simple.", "noteCn": "反对天真者查理而被拥立。" },
    { "personId": "e51174bf-d6a5-4358-acf3-516bdcd2897b", "startYear": 923, "endYear": 936, "titleForm": "King of West Francia", "note": "Elected after Robert I's death.", "noteCn": "罗贝尔一世阵亡后被拥立。" },
    { "personId": "b647d9d4-bdd3-40a9-9a54-240ff24540da", "startYear": 936, "endYear": 954, "titleForm": "King of West Francia", "note": "Recalled from England (d'Outremer).", "noteCn": "自英格兰归来（海外归来者）。" },
    { "personId": "9455d227-ae13-44dc-9924-138ac5208ed6", "startYear": 954, "endYear": 986, "titleForm": "King of West Francia", "note": "Succeeded his father Louis IV.", "noteCn": "继承父亲路易四世。" },
    { "personId": "653f343d-cd5f-4549-8e77-1f85c755a54a", "startYear": 986, "endYear": 987, "titleForm": "King of West Francia", "note": "Succeeded his father Lothair; last Carolingian king of West Francia.", "noteCn": "继承父亲洛泰尔，为西法兰克最后一位加洛林国王。" },
    { "personId": "6f92645c-bd9a-414d-9402-749dce748343", "startYear": 987, "endYear": 996, "titleForm": "King of the Franks", "note": "Elected after Louis V died without heirs, founding the Capetian line.", "noteCn": "路易五世无嗣去世后被选为国王，开创卡佩世系。" },
    { "personId": "fb8cf6a9-fad8-46e6-87aa-99dd01fe3ce9", "startYear": 996, "endYear": 1031, "titleForm": "King of the Franks", "note": "Succeeded his father Hugh Capet.", "noteCn": "继承父亲于格·卡佩。" },
    { "personId": "067aff89-074c-4f6c-80e8-9bd741741f88", "startYear": 1031, "endYear": 1060, "titleForm": "King of the Franks", "note": "Succeeded his father Robert II.", "noteCn": "继承父亲罗贝尔二世。" },
