    { "personId": "f0d935d4-8efa-482c-bccb-ac105babc10d", "startYear": 1314, "endYear": 1316, "titleForm": "King of France", "note": "Succeeded his father Philippe IV.", "noteCn": "继承父亲腓力四世。" },
    { "personId": "39979ed9-fafd-48f0-96d7-30f40e80f51b", "startYear": 1316, "endYear": 1316, "titleForm": "King of France", "note": "Reigned five days as a posthumous infant.", "noteCn": "遗腹子，在位仅五日。" },
    { "personId": "f57da4e3-19a4-4087-8cf4-613a2ff0bc1f", "startYear": 1316, "endYear": 1322, "titleForm": "King of France", "note": "Succeeded his infant nephew John I.", "noteCn": "继承幼侄约翰一世。" },
    { "personId": "da988cef-12ff-4b79-afad-70d0565b976e", "startYear": 1322, "endYear": 1328, "titleForm": "King of France", "note": "Last Capetian king of the direct line.", "noteCn": "直系卡佩最后一位国王。" },
    { "personId": "c89b7f1b-b6d2-4681-9eba-4cd9ffffab47", "startYear": 1328, "endYear": 1350, "titleForm": "King of France", "note": "First Valois king; his claim was disputed by Edward III of England.", "noteCn": "首任瓦卢瓦国王，其王位主张遭英格兰爱德华三世质疑。" },
